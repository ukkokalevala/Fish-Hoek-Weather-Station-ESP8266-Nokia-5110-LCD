#include <ESP8266WiFi.h>
#include <WiFiUdp.h>
#include <SPI.h>
#include <Adafruit_GFX.h>
#include <Adafruit_PCD8544.h>

// ===== Wemos D1 Hardware SPI =====
#define DC_PIN   12   // D6
#define CE_PIN   5    // D1
#define RST_PIN  4    // D2
Adafruit_PCD8544 display = Adafruit_PCD8544(DC_PIN, CE_PIN, RST_PIN);

// ===== CONFIG =====
const char* SSID = "YOUR_SSID";        // <<< EDIT
const char* PASS = "YOUR_PASSWORD";    // <<< EDIT
const char* LAT  = "-34.136002";       // Fish Hoek, Cape Town
const char* LON  = "18.430000";
const long  TZ_OFFSET = 2 * 3600;      // SAST (UTC+2)
const char* ntpServer = "za.pool.ntp.org";
// ==================

WiFiUDP udp;
unsigned long lastNtp    = 0;
unsigned long ntpEpoch   = 0;
unsigned long ntpMillis  = 0;
bool          ntpSynced  = false;

float         temperature = NAN;
int           weatherCode = -1;
unsigned long lastWeather = 0;

// ===== 8x8 icons (PROGMEM) =====
static const uint8_t PROGMEM icon_sun[] = {
  0x18,0x3C,0x7E,0xFF,0xFF,0x7E,0x3C,0x18
};
static const uint8_t PROGMEM icon_cloud[] = {
  0x00,0x1C,0x3E,0x7F,0x7E,0x3E,0x1C,0x00
};
static const uint8_t PROGMEM icon_rain[] = {
  0x1C,0x3E,0x7F,0x7E,0x1C,0x22,0x44,0x22
};
static const uint8_t PROGMEM icon_snow[] = {
  0x22,0x14,0x08,0x7F,0x08,0x14,0x22,0x00
};
static const uint8_t PROGMEM icon_unk[] = {
  0x3C,0x42,0x40,0x18,0x10,0x00,0x10,0x00
};

const uint8_t* pickIcon(int c) {
  if (c < 0)              return icon_unk;
  if (c == 0)             return icon_sun;
  if (c >= 1  && c <= 3)  return icon_cloud;
  if (c >= 45 && c <= 48) return icon_cloud;
  if (c >= 51 && c <= 67) return icon_rain;
  if (c >= 71 && c <= 77) return icon_snow;
  if (c >= 80 && c <= 82) return icon_rain;
  if (c >= 85 && c <= 86) return icon_snow;
  if (c >= 95)            return icon_rain;
  return icon_unk;
}

const char* descFor(int c) {
  if (c < 0)                     return "Loading";
  if (c == 0)                    return "Clear";
  if (c == 1)                    return "Mostly clear";
  if (c == 2)                    return "Partly cloudy";
  if (c == 3)                    return "Overcast";
  if (c == 45 || c == 48)        return "Fog";
  if (c >= 51 && c <= 55)        return "Drizzle";
  if (c >= 61 && c <= 65)        return "Rain";
  if (c >= 71 && c <= 75)        return "Snow";
  if (c >= 80 && c <= 82)        return "Showers";
  if (c >= 95)                   return "Thunder";
  return "N/A";
}

// ===== NTP =====
void ntpSync() {
  udp.begin(2390);
  byte packet[48];
  memset(packet, 0, 48);
  packet[0] = 0b11100011;
  packet[1] = 0;
  packet[2] = 6;
  packet[3] = 0xEC;

  IPAddress ip;
  if (!WiFi.hostByName(ntpServer, ip)) {
    Serial.println("NTP dns fail");
    udp.stop();
    return;
  }
  udp.beginPacket(ip, 123);
  udp.write(packet, 48);
  udp.endPacket();

  unsigned long t0 = millis();
  while (millis() - t0 < 1500) {
    if (udp.parsePacket() >= 48) {
      udp.read(packet, 48);
      unsigned long hi = ((unsigned long)packet[40] << 24) |
                         ((unsigned long)packet[41] << 16) |
                         ((unsigned long)packet[42] << 8)  |
                          (unsigned long)packet[43];
      unsigned long secs = hi - 2208988800UL;
      ntpEpoch  = secs + TZ_OFFSET;
      ntpMillis = millis();
      ntpSynced = true;
      lastNtp   = millis();
      Serial.print("NTP ok: "); Serial.println(secs);
      udp.stop();
      return;
    }
    delay(10);
  }
  udp.stop();
  Serial.println("NTP fail");
}

unsigned long localSeconds() {
  if (!ntpSynced) return 0;
  return ntpEpoch + (millis() - ntpMillis) / 1000UL;
}

// ===== Weather =====
void fetchWeather() {
  if (WiFi.status() != WL_CONNECTED) return;

  WiFiClient client;
  client.setTimeout(3000);

  if (!client.connect("api.open-meteo.com", 80)) {
    Serial.println("WX connect fail");
    return;
  }

  String url = String("/v1/forecast?latitude=") + LAT +
               "&longitude=" + LON +
               "&current=temperature_2m,weather_code";

  client.print(String("GET ") + url + " HTTP/1.0\r\n" +
               "Host: api.open-meteo.com\r\n" +
               "User-Agent: ESP8266\r\n" +
               "\r\n");

  String raw;
  raw.reserve(1400);
  unsigned long t0 = millis();
  unsigned long lastByte = millis();

  while (client.connected() && !client.available() && millis() - t0 < 5000) delay(10);

  while (millis() - t0 < 8000) {
    if (client.available()) {
      raw += (char)client.read();
      lastByte = millis();
      if (raw.length() > 1400) break;
    } else if (!client.connected()) {
      if (raw.length() > 0 && millis() - lastByte > 100) break;
    } else {
      delay(5);
      yield();
    }
  }
  client.stop();

  int hdrEnd = raw.indexOf("\r\n\r\n");
  if (hdrEnd < 0) {
    Serial.println("WX no header end");
    return;
  }
  String body = raw.substring(hdrEnd + 4);

  // Dechunk if needed
  if (body.length() > 4 && isxdigit(body[0]) && body.indexOf("\r\n") > 0
      && body.indexOf("{") > body.indexOf("\r\n")) {
    String out;
    out.reserve(body.length());
    int i = 0;
    while (i < (int)body.length()) {
      int lineEnd = body.indexOf("\r\n", i);
      if (lineEnd < 0) break;
      long sz = strtol(body.substring(i, lineEnd).c_str(), NULL, 16);
      if (sz == 0) break;
      int dataStart = lineEnd + 2;
      int dataEnd = dataStart + sz;
      if (dataEnd > (int)body.length()) dataEnd = body.length();
      out += body.substring(dataStart, dataEnd);
      i = dataEnd + 2;
    }
    body = out;
  }

  Serial.print("BODY: "); Serial.println(body);

  // locate "current": { ... } — skips "current_units"
  int curIdx = body.indexOf("\"current\":{");
  if (curIdx < 0) {
    Serial.println("WX no current obj");
    return;
  }

  int tIdx = body.indexOf("\"temperature_2m\":", curIdx);
  int cIdx = body.indexOf("\"weather_code\":",   curIdx);
  if (tIdx < 0 || cIdx < 0) {
    Serial.println("WX parse fail");
    return;
  }

  int tStart = tIdx + 17;
  while (tStart < (int)body.length() &&
        (body[tStart] == ' ' || body[tStart] == ':')) tStart++;
  int tEnd = tStart;
  while (tEnd < (int)body.length() &&
        (body[tEnd] == '-' || body[tEnd] == '.' ||
         (body[tEnd] >= '0' && body[tEnd] <= '9'))) tEnd++;
  temperature = body.substring(tStart, tEnd).toFloat();

  int cStart = cIdx + 15;
  while (cStart < (int)body.length() &&
        (body[cStart] == ' ' || body[cStart] == ':')) cStart++;
  int cEnd = cStart;
  while (cEnd < (int)body.length() &&
         body[cEnd] >= '0' && body[cEnd] <= '9') cEnd++;
  weatherCode = body.substring(cStart, cEnd).toInt();

  Serial.print("Parsed: "); Serial.print(temperature);
  Serial.print("C code="); Serial.println(weatherCode);
}

// ===== Setup =====
void setup() {
  Serial.begin(9600);
  delay(300);
  Serial.println("\n--- Fish Hoek boot ---");
  Serial.print("Free heap: ");
  Serial.println(ESP.getFreeHeap());

  display.begin();
  display.setRotation(2);
  display.setContrast(60);
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(BLACK);
  display.setCursor(0, 0);
  display.println("WiFi...");
  display.display();

  WiFi.persistent(false);
  WiFi.disconnect(true);
  delay(200);
  WiFi.mode(WIFI_STA);
  WiFi.begin(SSID, PASS);

  Serial.print("Connecting to [");
  Serial.print(SSID);
  Serial.println("]");

  unsigned long t0 = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - t0 < 30000) {
    Serial.print(".");
    delay(500);
    yield();
  }
  Serial.println();

  if (WiFi.status() == WL_CONNECTED) {
    Serial.print("IP: "); Serial.println(WiFi.localIP());
    Serial.print("RSSI: "); Serial.println(WiFi.RSSI());
    ntpSync();
    fetchWeather();
    lastWeather = millis();
  } else {
    Serial.print("WiFi FAIL status=");
    Serial.println(WiFi.status());
    display.clearDisplay();
    display.setCursor(0, 0);
    display.println("WiFi FAIL");
    display.print("st:");
    display.println(WiFi.status());
    display.display();
  }
}

// ===== Loop =====
void loop() {
  if (ntpSynced && millis() - lastNtp > 3600000UL) ntpSync();

  if (millis() - lastWeather > 600000UL) {
    fetchWeather();
    lastWeather = millis();
  }

  display.clearDisplay();

  // Time (size 2)
  display.setTextSize(2);
  display.setCursor(0, 0);
  unsigned long s = localSeconds();
  if (s == 0) {
    display.print("--:--");
  } else {
    char buf[6];
    snprintf(buf, sizeof(buf), "%02d:%02d",
             (int)((s / 3600) % 24), (int)((s / 60) % 60));
    display.print(buf);
  }

  // Weather icon (top-right)
  display.drawBitmap(72, 0, pickIcon(weatherCode), 8, 8, BLACK);

  // Temperature
  display.setTextSize(1);
  display.setCursor(0, 20);
  if (isnan(temperature)) {
    display.print("--.-C");
  } else {
    display.print(temperature, 1);
    display.print("C");
  }

  // Description
  display.setCursor(0, 30);
  display.print(descFor(weatherCode));

  // Debug footer
  display.setCursor(0, 40);
  display.print("code:");
  display.print(weatherCode);

  display.display();
  delay(1000);
}
